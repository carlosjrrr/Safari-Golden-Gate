* text=auto

# Theme source files use LF across platforms.
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.xml text eol=lf

# Binary assets must never be line-ending normalized.
*.jpg binary
*.jpeg binary
*.png binary
*.thumb binary

